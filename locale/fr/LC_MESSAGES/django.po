#: plugins/snt_malaria/api/cost_unit_types/views.py
msgid ""
"Cannot delete this cost unit because it is used by one or more cost lines."
msgstr ""
"Il est impossible de supprimer cette unité de coût car elle est utilisée par "
"une ou plusieurs lignes de coût."

#: plugins/snt_malaria/api/cost_unit_types/views.py
msgid "A cost unit with this name already exists."
msgstr "Une unité de coût avec ce nom existe déjà."

#: plugins/snt_malaria/api/donors/views.py
msgid "A donor with this name already exists."
msgstr "Un donateur avec ce nom existe déjà."

#: plugins/snt_malaria/api/grants/serializers.py
msgid "Donor not found."
msgstr "Donateur inconnu."

#: plugins/snt_malaria/api/grants/views.py
msgid "A grant with this name already exists."
msgstr "Un financement avec ce nom existe déjà."

#: plugins/snt_malaria/api/intervention_assignments/views.py
msgid "The scenario is locked and cannot be modified."
msgstr "Le scenario est verouillé et ne peut être modifié."

#: plugins/snt_malaria/api/intervention_categories/views.py
msgid ""
"Cannot delete this intervention category because it is used by one or more "
"interventions."
msgstr ""
"Il est impossible de supprimer cette catégorie d'intervention car elle est "
"utilisée par une ou plusieurs interventions."

#: plugins/snt_malaria/api/intervention_categories/views.py
msgid "An intervention category with this name already exists."
msgstr "Une catégorie d'intervention avec ce nom existe déjà."

#: plugins/snt_malaria/api/interventions/serializers.py
msgid "Intervention category not found."
msgstr "Catégorie d'intervention inconnue."

#: plugins/snt_malaria/api/interventions/serializers.py
msgid "Grant not found."
msgstr "Financement inconnu."

#: plugins/snt_malaria/api/interventions/views.py
msgid ""
"Cannot delete this intervention because it is used by one or more scenario "
"rules."
msgstr ""
"Il est impossible de supprimer cette intervention car elle est utilisée par "
"une ou plusieurs règles de scénario."

#: plugins/snt_malaria/api/openhexa_data_layers/client.py
#, python-brace-format
msgid "OpenHexa dataset '{slug}' was not found in workspace '{workspace}'."
msgstr ""
"Le jeu de données OpenHexa « {slug} » est introuvable dans l'espace de "
"travail « {workspace} »."

#: plugins/snt_malaria/api/openhexa_data_layers/client.py
#, python-brace-format
msgid "OpenHexa dataset '{slug}' has no versions."
msgstr "Le jeu de données OpenHexa « {slug} » n'a aucune version."

#: plugins/snt_malaria/api/openhexa_data_layers/client.py
#, python-brace-format
msgid "File '{filename}' was not found in OpenHexa dataset '{slug}'."
msgstr ""
"Le fichier « {filename} » est introuvable dans le jeu de données OpenHexa "
"« {slug} »."

#: plugins/snt_malaria/api/openhexa_data_layers/client.py
#, python-brace-format
msgid "Could not get a download URL for '{filename}'."
msgstr "Impossible d'obtenir une URL de téléchargement pour « {filename} »."

#: plugins/snt_malaria/api/openhexa_data_layers/client.py
#, python-brace-format
msgid "File '{filename}' is not valid JSON: {error}"
msgstr "Le fichier « {filename} » n'est pas un JSON valide : {error}"

#: plugins/snt_malaria/api/openhexa_data_layers/importer.py
#, python-brace-format
msgid "The source file has no '{column}' column."
msgstr "Le fichier source ne contient pas de colonne « {column} »."

#: plugins/snt_malaria/api/openhexa_data_layers/importer.py
#, python-brace-format
msgid "{rows} rows read, {matched} org units matched, writing {count} values"
msgstr ""
"{rows} lignes lues, {matched} unités d'organisation correspondantes, écriture "
"de {count} valeurs"

#: plugins/snt_malaria/api/openhexa_data_layers/serializers.py
#: plugins/snt_malaria/api/openhexa_data_layers/views.py
#, python-brace-format
msgid "The OpenHexa workspace configuration is missing the '{key}' key."
msgstr ""
"La configuration de l'espace de travail OpenHexa ne contient pas la clé "
"« {key} »."

#: plugins/snt_malaria/api/openhexa_data_layers/serializers.py
msgid "This data layer is not defined in OpenHexa."
msgstr "Cette couche de données n'est pas définie dans OpenHexa."

#: plugins/snt_malaria/api/openhexa_data_layers/serializers.py
msgid ""
"A layer with this data key already exists and is not managed by OpenHexa."
msgstr ""
"Une couche avec cette clé de données existe déjà et n'est pas gérée par "
"OpenHexa."

#: plugins/snt_malaria/api/openhexa_data_layers/source.py
#, python-brace-format
msgid ""
"Dataset identifier '{name}' is not defined in SNT_config.json "
"(SNT_DATASET_IDENTIFIERS)."
msgstr ""
"L'identifiant de jeu de données « {name} » n'est pas défini dans "
"SNT_config.json (SNT_DATASET_IDENTIFIERS)."

#: plugins/snt_malaria/api/openhexa_data_layers/source.py
msgid "This data layer has no usable SOURCE_DATA."
msgstr "Cette couche de données n'a pas de SOURCE_DATA exploitable."

#: plugins/snt_malaria/api/openhexa_data_layers/source.py
msgid "SOURCE_DATA is missing DATASET.NAME, FILENAME or COLUMN."
msgstr "SOURCE_DATA n'a pas de DATASET.NAME, FILENAME ou COLUMN."

#: plugins/snt_malaria/api/openhexa_data_layers/views.py
msgid "Failed to fetch data layers from OpenHexa."
msgstr "Échec de la récupération des couches de données depuis OpenHexa."

#: plugins/snt_malaria/api/openhexa_data_layers/views.py
msgid "The OpenHexa data layer configuration file is malformed."
msgstr ""
"Le fichier de configuration des couches de données OpenHexa est mal formé."

#: plugins/snt_malaria/api/scenarios/serializers.py
msgid "Cannot modify a locked scenario."
msgstr "Il n'est pas possible de modifier un scenario verouillé"

#: plugins/snt_malaria/api/scenarios/serializers.py
msgid "Start year must be between 2024 and 2035."
msgstr "L'année de début doit être entre 2024 et 2035."

#: plugins/snt_malaria/api/scenarios/serializers.py
#: plugins/snt_malaria/api/scenarios/views.py
msgid "Start year should be lower or equal end year."
msgstr "L'année de début doit être la même ou avant l'année de fin"

#: plugins/snt_malaria/api/scenarios/serializers.py
#, python-format
msgid "Invalid metric type ids: %(ids)s"
msgstr "Metric type id invalides: %(ids)s"

#: plugins/snt_malaria/api/scenarios/serializers.py
msgid "A scenario with this name already exists for your account."
msgstr "Un scénario pour votre compte existe déjà avec ce nom"

#: plugins/snt_malaria/api/scenarios/serializers.py
msgid "The file must be a CSV."
msgstr "Le fichier doit être un CSV"

#: plugins/snt_malaria/api/scenarios/serializers.py
msgid "The CSV must contain an 'org_unit_id' column."
msgstr "Le CSV doit contenir une colone 'org_unit_id'"

#: plugins/snt_malaria/api/scenarios/views.py
msgid "Scenario with this name already exists."
msgstr "Un scénario avec ce nom existe déjà"

